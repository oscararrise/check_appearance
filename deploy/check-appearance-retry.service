[Unit]
Description=Retry failed Check Appearance Power Automate deliveries
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/check_appearance
EnvironmentFile=/home/ubuntu/apps/check_appearance/.env
ExecStart=/home/ubuntu/apps/check_appearance/.venv/bin/python manage.py retry_power_automate --limit 200
Nice=5

[Install]
WantedBy=multi-user.target
