[Unit]
Description=Purge retained Check Appearance source uploads
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/check_appearance
EnvironmentFile=/home/ubuntu/apps/check_appearance/.env
ExecStart=/home/ubuntu/apps/check_appearance/.venv/bin/python manage.py purge_processed_uploads
Nice=10

[Install]
WantedBy=multi-user.target
