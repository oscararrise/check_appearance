limit_req_zone $binary_remote_addr zone=appearance_login:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=appearance_lookup:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=appearance_api:10m rate=120r/m;

upstream check_appearance_gunicorn {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    server_name appearance.example.internal;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name appearance.example.internal;

    ssl_certificate /etc/ssl/certs/appearance.crt;
    ssl_certificate_key /etc/ssl/private/appearance.key;

    server_tokens off;
    client_max_body_size 25m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    location /static/ {
        alias /home/ubuntu/apps/check_appearance/staticfiles/;
        access_log off;
        expires 1d;
    }

    location /media/ {
        return 404;
    }

    location = /login/ {
        limit_req zone=appearance_login burst=10 nodelay;
        proxy_pass http://check_appearance_gunicorn;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location = /admin/login/ {
        limit_req zone=appearance_login burst=10 nodelay;
        proxy_pass http://check_appearance_gunicorn;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location = /api/employee/lookup/ {
        limit_req zone=appearance_lookup burst=20 nodelay;
        proxy_pass http://check_appearance_gunicorn;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location /api/ {
        limit_req zone=appearance_api burst=40 nodelay;
        proxy_pass http://check_appearance_gunicorn;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 45s;
        proxy_send_timeout 45s;
    }

    location / {
        proxy_pass http://check_appearance_gunicorn;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 45s;
        proxy_send_timeout 45s;
    }
}
