DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_TRUST_X_FORWARDED_PROTO=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO

# Appearance application database (read/write)
DB_NAME=check_appearance_db
DB_USER=check_appearance_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONNECT_TIMEOUT_SECONDS=5

# HiBob source database. The application also opens this connection in
# PostgreSQL default_transaction_read_only mode.
HIBOB_DB_NAME=arrise_vm_db
HIBOB_DB_USER=check_appearance_app
HIBOB_DB_PASSWORD=change-me
HIBOB_DB_HOST=127.0.0.1
HIBOB_DB_PORT=5432

# Appearance Check -> downstream Power Automate delivery.
POWER_AUTOMATE_ENABLED=False
POWER_AUTOMATE_FLOW_URL=
POWER_AUTOMATE_API_KEY=
POWER_AUTOMATE_TIMEOUT_SECONDS=5
POWER_AUTOMATE_MAX_ATTEMPTS=5
POWER_AUTOMATE_RETRY_DELAYS_SECONDS=60,300,900,1800

# Workforce/studio lookup through Power Automate.
POWER_AUTOMATE_LOOKUP_ENABLED=False
POWER_AUTOMATE_LOOKUP_FLOW_URL=
POWER_AUTOMATE_LOOKUP_API_KEY=
POWER_AUTOMATE_LOOKUP_TIMEOUT_SECONDS=15
POWER_AUTOMATE_LOOKUP_MAX_RESPONSE_BYTES=2097152

# Card Resolver API. Keep the real service token only in the VM secret store/.env.
CARD_RESOLVER_ENABLED=False
CARD_RESOLVER_URL=https://YOUR_HOST/card-resolver/api/v1/cards/resolve
CARD_RESOLVER_SERVICE_TOKEN=
CARD_RESOLVER_TIMEOUT_SECONDS=5
CARD_RESOLVER_MAX_RESPONSE_BYTES=262144

# Upload retention and safety limits.
APPEARANCE_MAX_UPLOAD_BYTES=26214400
APPEARANCE_MAX_UPLOAD_ROWS=200000
APPEARANCE_MAX_UNCOMPRESSED_UPLOAD_BYTES=262144000
UPLOAD_RETENTION_DAYS=7
